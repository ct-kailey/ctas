NODE_ENV=development
PORT=3100
APP_ORIGIN=http://127.0.0.1:3100
DATABASE_URL=postgresql://ains:local-development-only@127.0.0.1:55432/ains
PYTHON_BIN=python3
BOOTSTRAP_ADMIN_EMAIL=admin@ains.local
BOOTSTRAP_ADMIN_NAME=AINS 관리자
# Set a unique password with 12+ characters. Existing users are never reset at startup.
BOOTSTRAP_ADMIN_PASSWORD=
# Production requires both. Local development can read existing 0600 nora/.secrets files.
NORA_PIPELINE_TOKEN=
NORA_FLOW_TOKEN=
# Optional; registration assistant stays unavailable until its Nora flow is published.
NORA_REGISTRATION_TOKEN=
## Optional; channel triage falls back to human review when unavailable.
NORA_CHANNEL_TRIAGE_TOKEN=
## Optional; required for the published implementation-planning flow.
NORA_IMPLEMENTATION_TOKEN=

# Optional Google login. Configure both together; callback is APP_ORIGIN/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional company Google signup; comma-separated exact Workspace domains. Empty disables new signup.
GOOGLE_SIGNUP_ALLOWED_DOMAINS=

# Nora proposal / estimate / contract formatting flow
NORA_COMMERCIAL_TOKEN=

# Main Context native approval flow; configure webhook only after deploying its receiver.
NORA_CONTEXT_TOKEN=
NORA_CONTEXT_WEBHOOK_SECRET=

# Nora pre-flight / result / maintenance analysis, with a native approval gate.
NORA_WORK_REVIEW_TOKEN=
NORA_WORK_WEBHOOK_SECRET=

# Context extensions: base64-encoded random 32-byte vault key; preserve across deployments.
AINS_CREDENTIAL_ENCRYPTION_KEY=
# Optional shared default. Prefer per-project encrypted key in Project settings.
OPENAI_API_KEY=
