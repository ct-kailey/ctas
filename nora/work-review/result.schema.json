{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "context_version",
    "target_type",
    "target_id",
    "input_sha256",
    "summary",
    "findings",
    "resources",
    "coverage",
    "category",
    "assignee_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "context_version": {
      "type": "integer",
      "minimum": 0
    },
    "target_type": {
      "enum": [
        "preflight",
        "validation",
        "classification"
      ]
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 0,
      "maxLength": 5000
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "source_ids",
          "question"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "severity": {
            "enum": [
              "blocking",
              "review",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "source_ids": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "question": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "key",
          "reason",
          "source_ids"
        ],
        "properties": {
          "kind": {
            "enum": [
              "feature",
              "path",
              "policy"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_ids": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "status",
          "reason",
          "source_ids"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "satisfied",
              "missing",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "source_ids": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "category": {
      "enum": [
        null,
        "in_scope_maintenance",
        "bug_fix",
        "requirement_change",
        "new_feature",
        "commercial_review",
        "uncertain"
      ]
    },
    "assignee_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      ]
    }
  }
}
