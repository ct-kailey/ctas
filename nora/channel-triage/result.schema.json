{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["classification", "title", "summary", "record_kind", "confidence", "evidence_event_ids", "reason"],
  "properties": {
    "classification": {"enum": ["decision", "action_item", "requirement_change", "discussion", "noise"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "record_kind": {"enum": ["conversation", "decision", "work_item", "note"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_event_ids": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"}},
    "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
