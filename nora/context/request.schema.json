{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","request_id","project_id","domain_id","context_version","sources","current_items"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "request_id": {"type":"string","minLength":1,"maxLength":120},
    "project_id": {"type":"string","minLength":1,"maxLength":120},
    "domain_id": {"type":["string","null"],"maxLength":120},
    "context_version": {"type":"integer","minimum":0},
    "sources": {"type":"array","minItems":1,"maxItems":30,"items":{
      "type":"object","additionalProperties":false,
      "required":["source_id","content","occurred_at","source_type","title"],
      "properties": {
        "source_id":{"type":"string","minLength":1,"maxLength":160},
        "content":{"type":"string","minLength":1,"maxLength":60000},
        "occurred_at":{"type":["string","null"],"maxLength":40},
        "source_type":{"type":"string","minLength":1,"maxLength":80},
        "title":{"type":"string","maxLength":300}
      }
    }},
    "current_items":{"type":"array","maxItems":200,"items":{
      "type":"object","additionalProperties":false,
      "required":["item_id","kind","title","content"],
      "properties":{
        "item_id":{"type":"string","minLength":1,"maxLength":160},
        "kind":{"type":"string","minLength":1,"maxLength":50},
        "title":{"type":"string","maxLength":300},
        "content":{"type":"string","maxLength":10000}
      }
    }}
  }
}
