{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "context_version",
    "summary",
    "items",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "context_version": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "title",
          "content",
          "rationale",
          "alternatives",
          "evidence",
          "conflicts_with",
          "certainty",
          "scope"
        ],
        "properties": {
          "kind": {
            "enum": [
              "fact",
              "requirement",
              "decision",
              "question",
              "change",
              "conflict",
              "worklog"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "rationale": {
            "type": "string",
            "maxLength": 4000
          },
          "alternatives": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "status",
                "reason"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "status": {
                  "enum": [
                    "accepted",
                    "rejected",
                    "open"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 2000
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "quote"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 3000
                }
              }
            }
          },
          "conflicts_with": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "certainty": {
            "enum": [
              "agreed",
              "ambiguous",
              "proposed"
            ]
          },
          "scope": {
            "enum": [
              "in_scope",
              "change_request",
              "unknown"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
