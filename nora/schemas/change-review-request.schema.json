{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change-review-request",
  "version": "1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "filename",
            "mime_type",
            "sha256"
          ],
          "additionalProperties": false
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "segment_id": {
                "type": "string",
                "minLength": 1
              },
              "requirement_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "page",
                      "slide",
                      "sheet",
                      "paragraph",
                      "text"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "label"
                ],
                "additionalProperties": false
              },
              "extraction_status": {
                "type": "string",
                "enum": [
                  "ok",
                  "needs_review"
                ]
              },
              "normalized_text": {
                "type": "string"
              }
            },
            "required": [
              "segment_id",
              "requirement_key",
              "text",
              "locator",
              "extraction_status"
            ],
            "additionalProperties": false
          }
        },
        "extraction": {
          "type": "object",
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "complete",
            "warnings"
          ],
          "additionalProperties": false
        },
        "normalization": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "needs_review"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "segment_count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "status",
            "warnings",
            "segment_count"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "document_id",
        "revision_id",
        "source",
        "segments",
        "extraction"
      ],
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "filename": {
              "type": "string",
              "minLength": 1
            },
            "mime_type": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "filename",
            "mime_type",
            "sha256"
          ],
          "additionalProperties": false
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "segment_id": {
                "type": "string",
                "minLength": 1
              },
              "requirement_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "page",
                      "slide",
                      "sheet",
                      "paragraph",
                      "text"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "label"
                ],
                "additionalProperties": false
              },
              "extraction_status": {
                "type": "string",
                "enum": [
                  "ok",
                  "needs_review"
                ]
              },
              "normalized_text": {
                "type": "string"
              }
            },
            "required": [
              "segment_id",
              "requirement_key",
              "text",
              "locator",
              "extraction_status"
            ],
            "additionalProperties": false
          }
        },
        "extraction": {
          "type": "object",
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "complete",
            "warnings"
          ],
          "additionalProperties": false
        },
        "normalization": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "needs_review"
              ]
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "segment_count": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "status",
            "warnings",
            "segment_count"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "document_id",
        "revision_id",
        "source",
        "segments",
        "extraction"
      ],
      "additionalProperties": false
    },
    "domain_pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "id",
        "version",
        "glossary"
      ],
      "additionalProperties": false
    },
    "impact_map": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "requirement_key": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "screen",
                    "api",
                    "database",
                    "test",
                    "document",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "requirement_key",
          "targets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "baseline",
    "current",
    "domain_pack",
    "impact_map"
  ],
  "additionalProperties": false
}
