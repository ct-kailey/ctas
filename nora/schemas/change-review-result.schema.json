{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change-review-result",
  "version": "1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_review",
        "no_change",
        "blocked"
      ]
    },
    "changes": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "change_type": {
            "type": "string",
            "enum": [
              "added",
              "removed",
              "modified",
              "editorial",
              "uncertain"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "segment_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "page",
                          "slide",
                          "sheet",
                          "paragraph",
                          "text"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "segment_id",
                  "text",
                  "locator"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "segment_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "page",
                          "slide",
                          "sheet",
                          "paragraph",
                          "text"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "segment_id",
                  "text",
                  "locator"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "impacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "screen",
                    "api",
                    "database",
                    "test",
                    "document",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "provided",
                    "inferred"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "ref",
                "basis",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "change_id",
          "requirement_key",
          "change_type",
          "risk",
          "summary",
          "before",
          "after",
          "reason",
          "impacts"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "related_change_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requires_customer_decision": {
            "const": true
          }
        },
        "required": [
          "question_id",
          "related_change_ids",
          "question",
          "options",
          "requires_customer_decision"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "const": "not_requested"
        },
        "baseline_publication_allowed": {
          "const": false
        }
      },
      "required": [
        "status",
        "baseline_publication_allowed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "status",
    "changes",
    "questions",
    "warnings",
    "approval"
  ],
  "additionalProperties": false
}
