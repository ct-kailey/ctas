{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project-scoped registration classification request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "title", "text", "record_kind", "domains", "documents"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "text": { "type": "string", "maxLength": 20000 },
    "filename": { "type": "string", "minLength": 1, "maxLength": 255 },
    "record_kind": { "$ref": "#/$defs/record_kind" },
    "selected_domain_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "domains": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 2000 },
          "domain_pack": {
            "type": "object", "additionalProperties": false, "required": ["id", "version", "glossary"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 100 },
              "version": { "type": "string", "minLength": 1, "maxLength": 100 },
              "glossary": { "type": "array", "maxItems": 200, "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "documents": {
      "type": "array", "maxItems": 300,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "domain_id", "title", "record_kind"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "domain_id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "record_kind": { "$ref": "#/$defs/record_kind" },
          "excerpt": { "type": "string", "maxLength": 500 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "record_kind": { "enum": ["specification", "conversation", "decision", "work_item", "note"] }
  }
}
