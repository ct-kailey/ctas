{
  "name": "ains-sism-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env platform/server/start.js",
    "dev:web": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node scripts/build-web.cjs",
    "start": "node platform/server/start.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "user": "node --env-file-if-exists=.env scripts/provision-user.js",
    "test": "node --test --test-concurrency=2 tests/*.test.js platform/tests/*.test.js",
    "test:platform": "node --test --test-concurrency=2 platform/tests/*.test.js",
    "ctds:check-update": "node scripts/ctds-sync.cjs --check-latest",
    "ctds:sync": "node scripts/ctds-sync.cjs",
    "check:ctds": "node scripts/check-ctds-tokens.cjs && node scripts/check-ctds-components.cjs",
    "build:workspace": "node node_modules/vite/bin/vite.js build",
    "check:ctds:components": "node scripts/check-ctds-components.cjs",
    "desktop:dev": "node scripts/desktop.cjs dev",
    "desktop:web": "node scripts/desktop.cjs web",
    "desktop:build": "node scripts/desktop.cjs build",
    "desktop:build:web": "node scripts/desktop.cjs build:web",
    "desktop:info": "node scripts/desktop.cjs info",
    "desktop:test": "node scripts/desktop.cjs test"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tauri-apps/api": "2.12.4",
    "ajv": "8.20.0",
    "express": "5.2.1",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "lucide-react": "1.47.0",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "solar-icon-set": "2.0.1"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@conscience-technology/ctds": "0.4.4",
    "@tauri-apps/cli": "2.12.3",
    "pretendard": "1.3.9",
    "vite": "8.3.1"
  }
}
