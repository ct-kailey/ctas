{
  "name": "ains-sism-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env platform/server/start.js",
    "dev:web": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node scripts/build-web.cjs",
    "start": "node platform/server/start.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "user": "node --env-file-if-exists=.env scripts/provision-user.js",
    "test": "node --test tests/*.test.js platform/tests/*.test.js",
    "test:platform": "node --test platform/tests/*.test.js",
    "ctds:check-update": "node scripts/ctds-sync.cjs --check-latest",
    "ctds:sync": "node scripts/ctds-sync.cjs",
    "check:ctds": "node scripts/check-ctds-tokens.cjs",
    "build:workspace": "node node_modules/vite/bin/vite.js build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.3.3",
    "ajv": "8.20.0",
    "express": "5.2.1",
    "google-auth-library": "11.1.0",
    "helmet": "8.3.0",
    "lucide-react": "^0.577.0",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@conscience-technology/ctds": "0.2.5",
    "pretendard": "1.3.9",
    "vite": "8.3.1"
  }
}
